{
  "name": "cross-stitch",
  "version": "0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:update": "vitest run -u",
    "e2e": "npx playwright test",
    "perf": "npx playwright test canvas-perf --project=chromium",
    "perf:update": "PERF_BASELINE=update npx playwright test canvas-perf --project=chromium",
    "e2e:ui": "yarn e2e --ui",
    "e2e:codegen": "npx playwright codegen http://localhost:3000/",
    "e2e:update": "docker run --rm --network host -v $(pwd):/work/ -w /work/ -it mcr.microsoft.com/playwright:v1.40.0-jammy /bin/bash -c 'CI=true yarn e2e --update-snapshots && exit'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "next": "^14.2.11",
    "next-themes": "^0.4.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.4.19",
    "@playwright/test": "^1.40.1",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^0.34.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.0.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^1.1.0"
  }
}
